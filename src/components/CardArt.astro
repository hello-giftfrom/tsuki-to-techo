---
import {isPlaceholderImage} from '../utils/oracle-art.mjs';
import type {OracleCard} from '../data/cards';
import {media} from '../data/media';
interface Props {card:OracleCard;eager?:boolean;}
const {card,eager=false}=Astro.props;
const files=import.meta.glob('/public/images/oracle/*.{webp,png,jpg,avif}');
const custom=Object.keys(files).includes(`/public${card.image}`);
const source=custom?card.image:media.oracle.src;
// Compare actual bytes so replacing a file also removes the provisional-image label.
const placeholder=!custom||isPlaceholderImage(source,media.oracle.src);
---
<figure class="card-illustration">
  <div class="oracle-art" style={`aspect-ratio:${placeholder?'2 / 3':'1 / 1'}`}><img src={source} alt={placeholder?`共通の仮イラスト：${media.oracle.alt}`:`${card.title}のイラスト`} width={placeholder?700:512} height={placeholder?1050:512} loading={eager?'eager':'lazy'} decoding="async" data-fallback={media.oracle.src} data-fallback-alt={`共通の仮イラスト：${media.oracle.alt}`}/></div>
  <figcaption class="card-art-note" hidden={!placeholder}>共通の仮イラスト</figcaption>
</figure>
<script>
function fallback(img:HTMLImageElement){
  if(img.dataset.fallback&&img.getAttribute('src')!==img.dataset.fallback){
    img.src=img.dataset.fallback;
    img.alt=img.dataset.fallbackAlt||'共通の仮イラスト';
    const note=img.closest('figure')?.querySelector<HTMLElement>('figcaption');
    if(note)note.hidden=false;
  }
}
document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach(img=>{
  img.addEventListener('error',()=>fallback(img));
  if(img.complete&&img.naturalWidth===0)fallback(img);
});
</script>
