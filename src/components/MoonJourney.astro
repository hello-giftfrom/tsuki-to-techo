---
import MoonStatus from './MoonStatus.astro';
import {cards} from '../data/cards';
const prompt=cards[Math.floor(Date.now()/86400000)%cards.length].journalPrompt;
---
<div class="moon-journey" data-journey><img class="nordic-landscape" src="/images/nordic-lake.webp" width="1600" height="1067" alt="" fetchpriority="high" decoding="async"/><div class="moon-track" aria-hidden="true"><div class="journey-moon" data-moon><div class="moon-surface"></div></div></div>
<section class="night-opening"><div class="opening-copy"><h1>月と手帳</h1><p>月をしるべに、わたしを知る。</p><a class="opening-cta" href="#oracle-experience">今日のカードを、一枚。 <span aria-hidden="true">→</span></a></div><a class="journey-scroll" href="#tonights-moon">月を眺める<span aria-hidden="true">↓</span></a></section>
<section class="tonights-moon" id="tonights-moon"><div class="moon-caption"><p class="scene-number">一、月を眺める</p><h2>今夜の空に、<br/>ひと息ぶんの余白。</h2><MoonStatus/><p class="moon-whisper">月をしるべに、わたしを知る。</p><a href="#oracle-experience" class="journey-link">今日のカードを、一枚。 <span aria-hidden="true">↗</span></a></div></section>
</div>
<section class="paper-scene" data-paper><div class="paper-intro"><p class="scene-number">二、ページをひらく</p><h2>今月、何を願いますか？</h2><p>答えがまとまらなくても。<br/>白いページは、そのままのあなたを待っています。</p></div><div class="journal-spread"><div class="journal-spine" aria-hidden="true"></div><div class="journal-leaf"><p>今日、手帳に書くなら。</p><blockquote data-journal-prompt>「{prompt}」</blockquote><p class="paper-note">一行だけでも。<br/>ことばにならない気持ちも、そのまま。</p><a href="/journal/prompts/">ほかの問いを見つける ↗</a></div></div></section>
<script>
const journey=document.querySelector<HTMLElement>('[data-journey]');
const moon=document.querySelector<HTMLElement>('[data-moon]');
const media=matchMedia('(prefers-reduced-motion: reduce)');
if(journey&&moon){let scheduled=false;let active=true;
const update=()=>{scheduled=false;if(media.matches)return;const rect=journey.getBoundingClientRect();const progress=Math.max(0,Math.min(1,-rect.top/(rect.height-innerHeight*.65)));moon.style.transform=`translate3d(${Math.sin(progress*Math.PI)*-32}px,${progress*42}px,0) scale(${1-progress*.43})`;};
const observer=new IntersectionObserver(entries=>{active=entries[0].isIntersecting;moon.classList.toggle('is-paused',!active);if(active)update();});observer.observe(journey);
window.addEventListener('scroll',()=>{if(!scheduled&&active&&!media.matches){scheduled=true;requestAnimationFrame(update);}},{passive:true});
media.addEventListener('change',()=>{moon.style.transform='';update();});update();}
const paper=document.querySelector('[data-paper]');if(paper){const observer=new IntersectionObserver(entries=>{if(entries[0].isIntersecting){paper.classList.add('paper-open');observer.disconnect();}},{threshold:.18});observer.observe(paper);}
</script>
