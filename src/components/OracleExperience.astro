---
import {cards} from '../data/cards';
import {media} from '../data/media';
import OracleCardBack from './OracleCardBack.astro';
import OracleResult from './OracleResult.astro';
import ArticleCards from './ArticleCards.astro';
import {getArticles} from '../utils/articles';
const articles=(await getArticles()).filter(e=>['journal','journal/prompts'].includes(e.data.slug));
const names=['上段の左のカード','上段の中央のカード','上段の右のカード','下段の左のカード','下段の右のカード'];
---
<section class="oracle-world" data-oracle data-state="choose" style={`--lake:url('${media.lake.src}')`}>
<div class="oracle-choose" data-choose><header class="oracle-invitation"><div class="tiny-star" aria-hidden="true">✧</div><h1>心にとまった一枚を</h1><p>聞きたいことを、ひとつ心に思い浮かべてください。<br/>準備ができたら、心にとまった一枚を選んでください。</p></header>
<div class="five-cards" aria-label="裏向きのカードから選ぶ">{names.map(name=><button type="button" class="draw-card" data-draw aria-label={name} disabled><OracleCardBack/></button>)}</div>
<p class="draw-status" data-status role="status" aria-live="polite">カードを準備しています。</p><div class="lunar-ornament" aria-hidden="true">☽　◐　●　◑　☾</div><p class="choose-footnote">どの一枚も、<br/>いまのあなたと向き合う、小さなしるべ。</p>
<noscript><p class="noscript-message">カード選択にはJavaScriptが必要です。<br/><a href="/journal/prompts/">手帳に書く問いを読む</a></p></noscript></div>
<div class="oracle-results" data-results hidden>{cards.map(card=><OracleResult card={card} interactive/>)}<section class="related"><h2>関連する読みもの</h2><ArticleCards articles={articles}/></section></div>
</section>
<script>import {initOracle} from '../scripts/oracle';document.querySelectorAll<HTMLElement>('[data-oracle]').forEach(initOracle);</script>
