---
import {getMoonStatus} from '../data/moon';
const status=getMoonStatus();
---
<div class="moon-status"><p class="moon-date"><time data-today datetime={status.date}>{status.date.replaceAll('-',' / ')}</time><span>日本時間</span></p><div class="moon-facts"><span>今日の月 <strong data-phase>{status.today?.phase ?? '確認中'}</strong></span><span>月齢 <strong data-age>{status.today?.age ?? '—'}</strong></span></div><p data-moon-note class="muted small">{status.today ? `出典：${status.today.source}` : '正確な月情報を準備しています。'}</p></div>
<script>
import {getMoonStatus} from '../data/moon';
function refresh(){const s=getMoonStatus();document.querySelectorAll('time[data-today]').forEach(el=>{el.setAttribute('datetime',s.date);el.textContent=s.date.replaceAll('-',' / ');});document.querySelectorAll('[data-phase]').forEach(el=>el.textContent=s.today?.phase??'確認中');document.querySelectorAll('[data-age]').forEach(el=>el.textContent=String(s.today?.age??'—'));document.querySelectorAll('[data-moon-note]').forEach(el=>el.textContent=s.today?`出典：${s.today.source}`:'正確な月情報を準備しています。');}
refresh();document.addEventListener('visibilitychange',()=>{if(!document.hidden)refresh();});setInterval(refresh,60000);
</script>
