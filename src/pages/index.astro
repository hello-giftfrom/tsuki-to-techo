---
import Layout from '../layouts/Layout.astro';
import ArticleCards from '../components/ArticleCards.astro';
import {getArticles} from '../utils/articles';
import {media} from '../data/media';
const all=await getArticles();
const preferred=['new-moon','full-moon','journal','oracle/guide'];
const latest=[...all].sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime()||(preferred.indexOf(a.data.slug)<0?99:preferred.indexOf(a.data.slug))-(preferred.indexOf(b.data.slug)<0?99:preferred.indexOf(b.data.slug))).slice(0,4);
const featured=all.filter(e=>e.data.featured).slice(0,4);
const gateways=[['☼','新月の願い事','書き方・自分のことば','/new-moon/'],['◑','満月の手放し','振り返りと整え方','/full-moon/'],['▤','手帳の書き方','ジャーナリングのヒント','/journal/'],['♧','読みもの','月と、自分を知る時間','/reading/']];
---
<Layout title="月と手帳" description="月をしるべに、わたしを知る。新月の願い事、満月の振り返り、ジャーナリングとオラクルカード。自分のことばで生きるための、小さな習慣を届けます。" home>
<section class="home-hero"><img {...media.lake} alt="" fetchpriority="high" decoding="async"/><div class="hero-copy"><h1>月と手帳</h1><p class="brand-copy">月をしるべに、<br/>わたしを知る。</p><p class="hero-note">日々の中に、少しの余白を。<br/>月のリズムとともに、<br/>わたしの言葉で生きていく。</p><a class="pill" href="/oracle/">今日のカードを引く <span aria-hidden="true">→</span></a></div></section>
<nav class="gateways shell" aria-label="コンテンツの入口">{gateways.map(([symbol,title,subtitle,url])=><a href={url}><span class="gateway-symbol" aria-hidden="true">{symbol}</span><strong>{title}</strong><small>{subtitle}</small></a>)}</nav>
<section class="shell magazine-section"><div class="section-heading"><h2>新着記事</h2><a href="/reading/">すべて見る <span aria-hidden="true">→</span></a></div><ArticleCards articles={latest} compact/></section>
{featured.length>0&&<section class="featured-section" style={`--lake:url('${media.lake.src}')`}><div class="shell"><div class="section-heading"><h2>今、読んでほしい読みもの</h2><p>月と手帳のおすすめ</p></div><ArticleCards articles={featured} compact/></div></section>}
<section class="brand-story"><div class="story-copy"><h2>手帳を書く、<br/>月のリズム。</h2><p>占うだけで終わらない。<br/>この場所は、あなたが自分の言葉で<br/>生きるための小さな灯りです。</p><a class="pill outline" href="/about/">はじめての方へ <span aria-hidden="true">→</span></a></div><img {...media.journal} loading="lazy" decoding="async"/></section>
<section class="values shell"><h2>月と手帳が大切にしていること</h2><div>{[['❧','直感を大切に','正解はひとつではありません。あなたの感じたことを信じて。'],['✎','自分の言葉で書く','誰かの言い方ではなく、わたしの願いを見つける。'],['☼','小さく行動する','願いを書いたら、できることをひとつ。'],['☾','やさしく続ける','うまくいかない日も、また月がしるべになります。']].map(([icon,title,body])=><section><span aria-hidden="true">{icon}</span><h3>{title}</h3><p>{body}</p></section>)}</div></section>
<section class="evening-invitation" style={`--lake:url('${media.lake.src}')`}><div class="shell"><h2>今夜、<br/>少しだけわたしに戻る。</h2><p>月のカードが、いまのあなたに<br/>そっと問いを届けます。</p><a class="pill" href="/oracle/">今日のカードを引く <span aria-hidden="true">→</span></a></div></section>
</Layout>
