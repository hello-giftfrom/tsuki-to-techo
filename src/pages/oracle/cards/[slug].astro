---
import {cards} from '../../../data/cards';
import Layout from '../../../layouts/Layout.astro';
import OracleResult from '../../../components/OracleResult.astro';
import ArticleCards from '../../../components/ArticleCards.astro';
import {getArticles} from '../../../utils/articles';
import {media} from '../../../data/media';
export function getStaticPaths(){return cards.map(card=>({params:{slug:card.slug},props:{card}}));}
const {card}=Astro.props;const articles=(await getArticles()).filter(e=>['journal','journal/prompts'].includes(e.data.slug));
---
<Layout title={`オラクルカード「${card.title}」`} description={card.affirmation} image={media.oracle.src} crumbs={[{name:'ホーム',url:'/'},{name:'カードを引く',url:'/oracle/'},{name:card.title,url:Astro.url.pathname}]}><div class="oracle-results static-result"><OracleResult card={card}/><section class="related"><h2>関連する読みもの</h2><ArticleCards articles={articles}/></section></div></Layout>
