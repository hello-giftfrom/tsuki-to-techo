---
import '../styles/global.css';
import {media,socials} from '../data/media';
import {jsonLd,type Crumb} from '../utils/seo';
interface Props{title:string;description:string;home?:boolean;dark?:boolean;article?:boolean;image?:string;crumbs?:Crumb[];schema?:Record<string,unknown>;}
const {title,description,home=false,dark=false,article=false,image=media.lake.src,crumbs=[],schema}=Astro.props;
const site=Astro.site!;const canonical=new URL(Astro.url.pathname,site).href;
const pageTitle=home?'月と手帳｜月をしるべに、わたしを知る。':`${title}｜月と手帳`;
const brandId=new URL('/#brand',site).href;
const nav=[{label:'カードを引く',href:'/oracle/'},{label:'新月と満月',href:'/new-moon/'},{label:'手帳を整える',href:'/journal/'},{label:'読みもの',href:'/reading/'}];
const graph:Record<string,unknown>[]=[{'@type':'Organization','@id':brandId,name:'月と手帳',url:site.href,description:'月とことばをきっかけに、自分を知り、手帳を書くためのWebマガジン。'},{'@type':'WebSite','@id':new URL('/#website',site).href,name:'月と手帳',url:site.href,inLanguage:'ja',publisher:{'@id':brandId}}];
if(crumbs.length)graph.push({'@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.url,site).href}))});
if(schema)graph.push({...schema,publisher:{'@id':brandId}});
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,site).href}/><meta property="og:site_name" content="月と手帳"/><meta property="og:locale" content="ja_JP"/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script is:inline type="application/ld+json" set:html={jsonLd({'@context':'https://schema.org','@graph':graph})}/></head>
<body class:list={{'dark-page':dark}}><a href="#main" class="skip">本文へ移動</a><header class="site-header"><a class="brand" href="/" aria-label="月と手帳 ホーム"><span aria-hidden="true">☾</span> 月と手帳</a><nav class="desktop-nav" aria-label="メイン">{nav.map(n=><a href={n.href} aria-current={Astro.url.pathname===n.href?'page':undefined}>{n.label}</a>)}</nav><details class="site-menu"><summary aria-label="メニューを開く"><span class="menu-lines" aria-hidden="true"></span></summary><nav aria-label="メニュー">{nav.map(n=><a href={n.href}>{n.label}</a>)}<a href="/full-moon/">満月の手放し</a><a href="/about/">このサイトについて</a></nav></details></header>
<main id="main">{crumbs.length>0&&<nav class="breadcrumbs shell" aria-label="パンくず">{crumbs.map((c,i)=><>{i>0&&<span aria-hidden="true"> / </span>}{i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<a href={c.url}>{c.name}</a>}</>)}</nav>}<slot/></main>
<footer class="site-footer"><div class="footer-top"><a class="brand" href="/"><span aria-hidden="true">☾</span> 月と手帳</a><nav aria-label="フッター">{nav.map(n=><a href={n.href}>{n.label}</a>)}<a href="/about/">このサイトについて</a></nav></div><p>月をしるべに、わたしを知る。<br/>月とことばをきっかけに、自分を知り、手帳を書くためのWebマガジン。</p>{socials.length>0&&<nav aria-label="SNS">{socials.map(s=><a href={s.url} rel="noopener noreferrer">{s.label}</a>)}</nav>}<small>© {new Date().getFullYear()} 月と手帳</small></footer>
<script>
import {initializeAnalytics} from '../utils/analytics';initializeAnalytics();
const menu=document.querySelector<HTMLDetailsElement>('.site-menu');
menu?.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus();}});
</script></body></html>
