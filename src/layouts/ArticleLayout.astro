---
import Layout from './Layout.astro';
import ArticleCards from '../components/ArticleCards.astro';
import {media} from '../data/media';
import {getArticles,relatedArticles,dateLabel,type Article} from '../utils/articles';
interface Props {entry:Article;headings:{depth:number;slug:string;text:string}[];}
const {entry,headings}=Astro.props;const d=entry.data;const image=media[d.image];
const canonical=new URL(`/${d.slug}/`,Astro.site).href;
const related=relatedArticles(entry,await getArticles());
const schema={'@type':'BlogPosting',headline:d.title,description:d.description,mainEntityOfPage:canonical,url:canonical,inLanguage:'ja',datePublished:d.publishedAt.toISOString(),...(d.updatedAt?{dateModified:d.updatedAt.toISOString()}:{}),author:{'@type':'Organization',name:d.author,url:new URL('/about/',Astro.site).href},image:new URL(image.src,Astro.site).href,articleSection:d.category};
---
<Layout title={d.title} description={d.description} image={image.src} article schema={schema} crumbs={[{name:'ホーム',url:'/'},{name:'読みもの',url:'/reading/'},{name:d.title,url:`/${d.slug}/`}]}>
<article class="article"><img class="article-hero" {...image} fetchpriority="high"/><div class="article-inner"><header class="article-heading"><a class="article-category" href={`/reading/#${{'新月の願い事':'new-moon','満月の手放し':'full-moon','手帳の書き方':'journal','オラクルカード':'oracle','読みもの':'essays'}[d.category]}`}>{d.category}</a><h1>{d.title}</h1><p class="article-meta"><span>公開 <time datetime={d.publishedAt.toISOString()}>{dateLabel(d.publishedAt)}</time></span>{d.updatedAt&&<span>更新 <time datetime={d.updatedAt.toISOString()}>{dateLabel(d.updatedAt)}</time></span>}<span>文：<a href="/about/">{d.author}</a></span></p><p class="article-description">{d.description}</p></header>
{headings.some(h=>h.depth===2)&&<nav class="toc" aria-label="目次"><h2>目次</h2><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}<span aria-hidden="true">＋</span></a></li>)}</ol></nav>}
<div class="prose"><slot/></div>
{d.firsthandNote&&<aside class="editorial-note"><h2>月と手帳の記録</h2><p>{d.firsthandNote}</p></aside>}
{d.sources.length>0&&<section class="sources"><h2>参考にした情報</h2><ul>{d.sources.map(s=><li><a href={s.url}>{s.title}</a></li>)}</ul></section>}
<aside class="article-cta"><span aria-hidden="true">☾</span><h2>ことばが見つからない日は、<br/>カードをしるべに。</h2><a class="pill" href="/oracle/">今日のカードを引く <span aria-hidden="true">→</span></a></aside><section class="related"><h2>関連する読みもの</h2><ArticleCards articles={related}/></section></div></article></Layout>
